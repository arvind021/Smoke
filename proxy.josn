{
    "proxies": {
        "socks5_proxy": {
            "type": "socks5",
            "host": "127.0.0.1",
            "port": 9050
        },
        "http_proxy": {
            "type": "http",
            "host": "proxy.example.com",
            "port": 8080
        },
        "proxy_with_auth": {
            "type": "socks5",
            "host": "proxy.example.com",
            "port": 1080,
            "username": "user",
            "password": "password"
        }
    }
}
